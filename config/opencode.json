{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["codex"],
  "lsp": {},
  "provider": {
    "codex": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://cx.aiserverai.online/v1",
        "apiKey": "{env:CCH_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": {
            "context": 1050000,
            "output": 130000
          },
          "cost": {
            "input": 5,
            "output": 30,
            "cache_read": 0.5,
            "context_over_200k": {
              "input": 10,
              "output": 45,
              "cache_read": 1
            }
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          },
          "variants": {
            "minimal": {
              "reasoningEffort": "minimal",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "cost": {
            "input": 0.75,
            "output": 4.5,
            "cache_read": 0.075
          }
        }
      }
    }
  }
}
